# Copy this file to .env and fill in real values for this server.
# .env is git-ignored - never commit real secrets.

DB_HOST=localhost
DB_USER=dialforge
DB_PASSWORD=
DB_NAME=dialforge_dev

ARI_HOST=localhost
ARI_PORT=8088
ARI_USER=dialforge
ARI_PASS=

AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=dialforge
AMI_PASS=

# Long random string - invalidates all logged-in sessions if changed.
SESSION_SECRET=

# Only used by `node seed-users.js` (one-time initial account creation).
ADMIN_PASSWORD=
AGENT1001_PASSWORD=
AGENT1002_PASSWORD=

# PSTN trunk this server dials out through - deployment-specific, not a secret.
TRUNK_ENDPOINT=dialforge-nxtra1
TRUNK_CALLER_ID=8065098690

QUEUES_CONF_PATH=/etc/asterisk/queues.conf
PORT=3000
