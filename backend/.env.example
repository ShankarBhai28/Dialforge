# Copy this file to .env and fill in real values for this server.
# .env is git-ignored - never commit real secrets.

DB_HOST=localhost
DB_USER=dialforge
DB_PASSWORD=
DB_NAME=dialforge_dev

ARI_HOST=localhost
ARI_PORT=8088
ARI_USER=dialforge
ARI_PASS=

AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=dialforge
AMI_PASS=

# Long random string - invalidates all logged-in sessions if changed.
SESSION_SECRET=

# Only used by `node seed-users.js` (one-time initial account creation).
ADMIN_PASSWORD=
AGENT1001_PASSWORD=
AGENT1002_PASSWORD=

# PSTN trunk this server dials out through - deployment-specific, not a secret.
TRUNK_ENDPOINT=dialforge-nxtra1
TRUNK_CALLER_ID=8065098690

PORT=3000

# Browser softphone (served by GET /agent/webrtc-config) - see src/services/webrtc.js
SIP_DOMAIN=
WEBRTC_WS_URL=
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# Same value as coturn's static-auth-secret (with use-auth-secret): every
# login gets its own TURN password that expires after TURN_TTL_SEC.
TURN_SECRET=
TURN_TTL_SEC=43200

# --- Operations (all optional) ---
# Alerts (system health problems, failed backups): any Slack-style incoming
# webhook URL - Slack, Google Chat, Microsoft Teams, Discord ("/slack" suffix).
ALERT_WEBHOOK_URL=
# Telegram alerts (ops/README.md): bot token from @BotFather, chat id from npm run alert:test -- --find-chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Daily "all OK" summary, local hour (REPORT_TIMEZONE)
ALERT_DAILY_HOUR=9
# Nightly backup (ops/backup.sh): off-server copy to this S3 bucket (the
# server needs an IAM role allowed to write to it), local copies kept N days.
BACKUP_S3_BUCKET=
BACKUP_KEEP_DAYS=14
# Agents whose line is unregistered this many minutes are logged out (0 = off).
STALE_AGENT_MINUTES=10
# Call recording: calls without a campaign are recorded unless this is 0;
# recordings older than this many days are deleted from the server nightly.
RECORD_CALLS_WITHOUT_CAMPAIGN=1
RECORDING_RETENTION_DAYS=90

# Reports: the center's time zone (IANA name). "Today" and hours in the
# reports are this zone's; times are stored in UTC.
REPORT_TIMEZONE=Asia/Kolkata

# The product name in alerts (Slack / Teams / Google Chat messages).
APP_DISPLAY_NAME=VIZTEX

# "production" on a client's server: test-only tools (db:reset-test-data) refuse to run.
APP_ENV=dev

# --- Cloud edition: many companies on one install (docs/plans/TENANTS_PLAN.md) ---
# Off unless 1. Then the login asks for a company code, every company has its
# own database (viztex_t_<code>), the company list and all logins live in
# PLATFORM_DB_NAME, and this server's own DB_NAME is the company HOME_TENANT_CODE.
# MULTI_TENANT=1
# PLATFORM_DB_NAME=viztex_platform
# HOME_TENANT_CODE=main
# TENANT_POOL_SIZE=5
# Asterisk reads every company's extensions and queues from this database (npm run tenant -- realtime).
# RT_DB_NAME=viztex_rt
